{
  "name": "controller-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tokens": "node --import tsx src/ui-kit/scripts/build-tokens.ts",
    "build:extension": "node --import tsx scripts/build-extension.ts",
    "build": "tsc --noEmit && tsc --project cloudflare/tsconfig.json && vite build",
    "start": "node server/index.ts",
    "test:cloudflare": "npm run build && node --test integration/cloudflare-relay.test.ts",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "wrangler": "^4.163.0"
  }
}
